# MediaMeshMenu — ClickMesh-generated custom action for PCManFM / PCManFM-Qt.
#
# Installation:
#   PCManFM (GTK)  :  ~/.local/share/file-manager/actions/
#   PCManFM-Qt     :  ~/.local/share/file-manager/actions/
#
# After copying, restart PCManFM to pick up the new actions.

[Desktop Entry]
Type=Action
Name=Media Mesh Convert
Icon=video-x-generic
Profiles=default;
MimeTypes=image/bmp;image/gif;image/jpeg;image/png;image/vnd.microsoft.icon;image/webp;
TargetLocation=true
Actions=Action0;Action1;Action2;

[Desktop Action Action0]
Name=Convert to JPG
Icon=image-x-generic
Exec=media_mesh -jpg %F

[Desktop Action Action1]
Name=Convert to BMP
Icon=image-x-generic
Exec=media_mesh -bmp %F

[Desktop Action Action2]
Name=Convert to ICO
Icon=image-x-generic
Exec=media_mesh -ico %F

