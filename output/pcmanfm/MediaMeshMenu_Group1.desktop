# MediaMeshMenu — ClickMesh-generated custom action for PCManFM / PCManFM-Qt.
#
# Installation:
#   PCManFM (GTK)  :  ~/.local/share/file-manager/actions/
#   PCManFM-Qt     :  ~/.local/share/file-manager/actions/
#
# After copying, restart PCManFM to pick up the new actions.

[Desktop Entry]
Type=Action
Name=Media Mesh Convert
Icon=video-x-generic
Profiles=default;
MimeTypes=audio/aac;audio/mp4;audio/mpeg;audio/ogg;audio/x-flac;audio/x-wav;image/bmp;image/gif;image/jpeg;image/png;image/vnd.microsoft.icon;image/webp;text/vnd.trolltech.linguist;video/mp4;video/quicktime;video/webm;video/x-flv;video/x-matroska;video/x-ms-wmv;video/x-msvideo;
TargetLocation=true
Actions=Action0;

[Desktop Action Action0]
Name=Show Media Info
Icon=dialog-information
Exec=media_mesh -info %F

