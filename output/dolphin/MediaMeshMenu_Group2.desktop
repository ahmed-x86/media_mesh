# MediaMeshMenu — ClickMesh-generated service menu for Dolphin (KDE).
#
# Installation:
#   KDE Plasma 5 :  ~/.local/share/kservices5/ServiceMenus/
#   KDE Plasma 6 :  ~/.local/share/kio/servicemenus/
#
# After copying, restart Dolphin or run:  kbuildsycoca6 (or kbuildsycoca5)

[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=audio/aac;audio/mp4;audio/mpeg;audio/ogg;audio/x-flac;audio/x-wav;image/bmp;image/gif;image/jpeg;image/png;image/vnd.microsoft.icon;image/webp;text/vnd.trolltech.linguist;video/mp4;video/quicktime;video/webm;video/x-flv;video/x-matroska;video/x-ms-wmv;video/x-msvideo;
X-KDE-Submenu=Media Mesh
X-KDE-Submenu[ar]=ميديا ميش
Icon=video-x-generic
Actions=Action0;Action1;Action2;Action3;Action4;Action5;

[Desktop Action Action0]
Name=Convert Video ▸ To MP4
Name[ar]=تحويل الفيديو ▸ إلى MP4
Icon=video-x-generic
Exec=sh -c '_cm=$(mktemp); cat > "$_cm" << '"'"'EOF'"'"'
if ! command -v media_mesh >/dev/null 2>&1; then
  zenity --error --text="Required binary 'media_mesh' not found." 2>/dev/null || kdialog --error "Required binary 'media_mesh' not found." 2>/dev/null
  exit 1
fi
for file in "$@"; do
  export file
  export dir="$(dirname "$file")"
  export filename="$(basename "$file")"
  ext="${filename##*.}"
  [ "$ext" = "$filename" ] && ext=""
  export ext
  export basename="${filename%.*}"
  export count=$#
  _iter_script=$(mktemp)
  cat > "$_iter_script" << 'INNEREOF'
media_mesh -mp4 "$file"
INNEREOF
  bash "$_iter_script"
  rm -f "$_iter_script"
done
EOF
sh "$_cm" "$@"; rm -f "$_cm"' -- %F

