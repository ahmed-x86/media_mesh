# MediaMeshMenu — ClickMesh-generated service menu for Dolphin (KDE).
#
# Installation:
#   KDE Plasma 5 :  ~/.local/share/kservices5/ServiceMenus/
#   KDE Plasma 6 :  ~/.local/share/kio/servicemenus/
#
# After copying, restart Dolphin or run:  kbuildsycoca6 (or kbuildsycoca5)

[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=text/vnd.trolltech.linguist;video/mp4;video/quicktime;video/webm;video/x-flv;video/x-matroska;video/x-ms-wmv;video/x-msvideo;
X-KDE-Submenu=Media Mesh Convert
Icon=video-x-generic
Actions=Action0;Action1;Action2;Action3;Action4;Action5;

[Desktop Action Action0]
Name=Convert to MP4
Icon=video-x-generic
Exec=media_mesh -mp4 %F

[Desktop Action Action1]
Name=Convert to MKV
Icon=video-x-generic
Exec=media_mesh -mkv %F

[Desktop Action Action2]
Name=Convert to WEBM
Icon=video-x-generic
Exec=media_mesh -webm %F

[Desktop Action Action3]
Name=Convert to AV1
Icon=video-x-generic
Exec=media_mesh -av1 %F

[Desktop Action Action4]
Name=DaVinci Resolve (DNxHD)
Icon=video-x-generic
Exec=media_mesh -davinci %F

[Desktop Action Action5]
Name=Apple ProRes (HQ)
Icon=video-x-generic
Exec=media_mesh -prores %F

