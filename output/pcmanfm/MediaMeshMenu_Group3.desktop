# MediaMeshMenu — ClickMesh-generated custom action for PCManFM / PCManFM-Qt.
#
# Installation:
#   PCManFM (GTK)  :  ~/.local/share/file-manager/actions/
#   PCManFM-Qt     :  ~/.local/share/file-manager/actions/
#
# After copying, restart PCManFM to pick up the new actions.

[Desktop Entry]
Type=Action
Name=Media Mesh Convert
Icon=video-x-generic
Profiles=default;
MimeTypes=audio/aac;audio/mp4;audio/mpeg;audio/ogg;audio/x-flac;audio/x-wav;text/vnd.trolltech.linguist;video/mp4;video/quicktime;video/webm;video/x-flv;video/x-matroska;video/x-ms-wmv;video/x-msvideo;
TargetLocation=true
Actions=Action0;Action1;

[Desktop Action Action0]
Name=Extract Audio (MP3)
Icon=audio-x-generic
Exec=media_mesh -mp3 %F

[Desktop Action Action1]
Name=Extract Audio (AAC)
Icon=audio-x-generic
Exec=media_mesh -aac %F

